POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Meeting assistant (OpenAI) ---
# Creates meetings from text or speech. Leave the key empty to turn the assistant off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Auth (Cognito) ---
# Filled in by `make deploy` (these are public IDs, not secrets). Local runs use the same
# user pool as AWS. The backend only accepts ID tokens from this pool and app client.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# Google sign-in: create an OAuth client in Google Cloud with the redirect URI
# https://<COGNITO_DOMAIN>/oauth2/idpresponse, set both values, and run make deploy.
# Leave empty to keep Google disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AWS deployment (make deploy) ---
# Credentials of an IAM user allowed to manage Lambda, EC2/VPC, RDS, ECR, IAM roles, S3,
# CloudFront, Cognito, CloudWatch Logs, and for a custom domain ACM and Route 53. Never commit
# real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Prefix for all AWS resource names; every resource is tagged PROJECT_NAME=<this>
PROJECT_NAME=new-project
# Extra origins allowed to call the deployed API, comma-separated. The CloudFront address
# and the custom domain are added automatically.
CORS_ORIGINS_AWS=
# Backend Lambda memory in MB (CPU scales with it; 400,000 GB-seconds/month are free)
LAMBDA_MEMORY=512

# --- Terraform state (HCP Terraform) ---
# The workspace holds the state; set its Execution Mode to Local (see README).
# A user or team API token from https://app.terraform.io/app/settings/tokens
TF_TOKEN_app_terraform_io=
TF_CLOUD_ORGANIZATION=
# Defaults to PROJECT_NAME
TF_WORKSPACE=

# --- Custom domain (make deploy) ---
# Host name for the frontend, e.g. app.example.com. Leave empty for the *.cloudfront.net address.
DOMAIN_NAME=
# Optional Route 53 hosted zone id of DOMAIN_NAME (e.g. Z0123456789ABC). If set, the DNS records
# are created for you; otherwise make deploy prints the records to add at your DNS provider.
HOSTED_ZONE_ID=
